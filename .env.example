# ============================================================================
# Variables de entorno de ejemplo (Desarrollo Local con Vite)
# Copia este archivo a `.env` o `.dev.vars` y configura valores reales.
# NUNCA subas secretos reales al repositorio.
# ============================================================================

# --- Autenticación y Sesión Privada (Requerido) ---
SITE_PASSWORD=cambia-esta-clave-secreta
SESSION_SECRET=reemplaza-con-una-cadena-aleatoria-de-al-menos-32-caracteres-seguros

# --- Integración con Spotify Web API ---
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui
SPOTIFY_PLAYLIST_ID=0EJqoSBZPUYuKNj36TKNxt
SPOTIFY_MARKET=MX

# Opcional: Solo si la playlist es privada o colaborativa y requiere OAuth de usuario
SPOTIFY_REFRESH_TOKEN=

# Opcional: Permitir fixture de demostración cuando Spotify no está configurado en desarrollo ("true" | "false")
ALLOW_DEMO_FIXTURE=true
