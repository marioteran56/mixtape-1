{
  // Configuración de Cloudflare (compatible con `npx wrangler deploy` en Workers Builds)
  // IMPORTANTE: No guardes secretos aquí (`SITE_PASSWORD`, `SESSION_SECRET`).
  // Configúralos en el panel de Cloudflare > Settings > Variables and Secrets.
  "name": "playlist-1",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/carta"
    ]
  },
  "vars": {
    "SPOTIFY_MARKET": "MX",
    "ALLOW_DEMO_FIXTURE": "false"
  }
}
