{
  // Configuración de Cloudflare (compatible con `npx wrangler deploy`)
  // Desactiva *.workers.dev y publica únicamente en mixtape.marioteran.dev/thinking-about-you*
  "name": "thinking-about-you",
  "main": "src/worker.ts",
  "compatibility_date": "2025-03-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mixtape.marioteran.dev/thinking-about-you*",
      "zone_name": "marioteran.dev"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "SPOTIFY_MARKET": "MX",
    "ALLOW_DEMO_FIXTURE": "false"
  }
}
